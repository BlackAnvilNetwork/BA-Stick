    arm_to: 1.0,
    arm_thick: 2.6,
    cuff_from: 0.0,
    cuff_to: 0.16,
    cuff_thick: 3.4,
    rows: [
        "cbbbbbbbbbbbbc",
        "cbkkbbbbbbkkbc",
        "cbkbbbbbbbbkbc",
        "cbkbmmmmmmbkbc",
        "cbkbbbbbbbbkbc",
