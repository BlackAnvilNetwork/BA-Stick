// BA battleweave coat: a cinched fighting coat to mid-thigh. No train.
// Steel seams and a waist cinch are ba_velvet_shirt.plate.ron.
// Sleeves run shoulder, elbow, then a wrist disk on the hand. `thick` is a
// radius in pixels. Sheets stay outside the bones.
(
    id: "ba_velvet_shirt",
    slot: Chest,
    attach: Some("chest"),
    material: Some("dust"),
    thickness_mul: {
        "spine": 1.22,
        "shoulders": 1.10,
    },
    shapes: [
        // Collar yoke.
        Capsule(
            from: (-0.13, -0.02, 0.04),
            to: (0.13, -0.02, 0.04),
            ramp: Material,
            thick: 2.6,
        ),
        // Chest down to a tight cinch. Negative y hangs down the torso.
        Capsule(
            from: (0.0, -0.02, 0.05),
            to: (0.0, -0.40, 0.035),
            ramp: Material,
            thick: 3.2,
        ),
        Capsule(
            from: (-0.11, -0.12, 0.05),
            to: (0.11, -0.12, 0.05),
            ramp: Material,
            thick: 3.2,
        ),
        Capsule(
            from: (-0.08, -0.28, 0.045),
            to: (0.08, -0.28, 0.045),
            ramp: Material,
            thick: 2.8,
        ),
        // Steel waist cinch.
        Capsule(
            from: (-0.040, -0.40, 0.04),
            to: (0.040, -0.40, 0.04),
            ramp: Trim,
            thick: 2.4,
        ),
        // Short shoulder drapes, fighting cut.
        Capsule(
            from: (-0.12, -0.04, 0.03),
            to: (-0.14, -0.28, 0.0),
            ramp: Material,
            thick: 2.4,
        ),
        Capsule(
            from: (0.12, -0.04, 0.03),
            to: (0.14, -0.28, 0.0),
            ramp: Material,
            thick: 2.4,
        ),
        // Short skirt panels, mid-thigh hem. No train.
        Capsule(
            from: (-0.02, -0.40, 0.03),
            to: (-0.12, -0.72, 0.02),
            ramp: Material,
            thick: 2.6,
        ),
        Capsule(
            from: (0.02, -0.40, 0.03),
            to: (0.12, -0.72, 0.02),
            ramp: Material,
            thick: 2.6,
        ),
        Capsule(
            from: (0.0, -0.40, 0.045),
            to: (0.0, -0.72, 0.02),
            ramp: Material,
            thick: 2.4,
        ),
        // Hem band at mid-thigh.
        Capsule(
            from: (-0.14, -0.70, 0.02),
            to: (0.14, -0.70, 0.02),
            ramp: Material,
            thick: 2.2,
        ),
    ],
)
