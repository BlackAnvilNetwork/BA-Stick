//
// Bronze sabatons. One foot in foot-local metres: origin is the foot
// joint, +y up the shin, +z toward the toe, +x the character's right.
// The viewer and draw path instance this pair on l_foot and r_foot so
// the soles walk with the stride. Tiny discs mark each joint.
// Lighter, thinner bronze plates than mythril — not ankle blobs.
// `thick` is a radius in pixels.
(
    id: "ba_bronze_sabatons",
    slot: Feet,
    attach: Some("pelvis"),
    material: Some("steel"),
    thickness_mul: {
        "l_shin": 1.08,
        "r_shin": 1.08,
    },
    shapes: [
        // Narrower platform sole width (front).
        Capsule(
            from: (-0.036, -0.024, 0.026),
            to: (0.036, -0.024, 0.026),
            ramp: Material,
            thick: 2.6,
        ),
        // Narrower platform heel width.
        Capsule(
            from: (-0.032, -0.024, -0.034),
            to: (0.032, -0.024, -0.034),
            ramp: Material,
            thick: 2.4,
        ),
        // Platform length, heel to ball.
        Capsule(
            from: (0.0, -0.024, -0.042),
            to: (0.0, -0.024, 0.026),
            ramp: Material,
            thick: 2.4,
        ),
        // Platform length, ball to toe.
        Capsule(
            from: (0.0, -0.024, 0.008),
            to: (0.0, -0.024, 0.092),
            ramp: Material,
            thick: 2.2,
        ),
        // Thin midsole lift.
        Capsule(
            from: (0.0, -0.008, -0.034),
            to: (0.0, -0.008, 0.050),
            ramp: Material,
            thick: 2.1,
        ),
        // Low vamp slab, sole up over the instep.
        Capsule(
            from: (0.0, -0.016, 0.034),
            to: (0.0, 0.046, 0.034),
            ramp: Material,
            thick: 2.0,
        ),
        // Thin vamp cover across the instep.
        Capsule(
            from: (-0.030, 0.024, 0.026),
            to: (0.030, 0.024, 0.026),
            ramp: Material,
            thick: 1.8,
        ),
        // Copper rivet strap on the instep (bronze read).
        Capsule(
            from: (-0.022, 0.030, 0.028),
            to: (0.022, 0.030, 0.028),
            ramp: Trim,
            thick: 1.2,
        ),
        // Low vamp toe wrap.
        Capsule(
            from: (0.0, -0.008, 0.060),
            to: (0.0, 0.018, 0.084),
            ramp: Material,
            thick: 1.6,
        ),
        Disc(at: Some("l_foot"), r: 0.012, ramp: Material),
        Disc(at: Some("r_foot"), r: 0.012, ramp: Material),
    ],
)
