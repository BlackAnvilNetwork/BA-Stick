//
// Scale harness hardware: shoulder straps fixed to the chest bone.
// The leather body is the pixel mesh in ba_scale_harness.plate.ron.
// Family look is the accepted leather vest. `thick` is a radius in pixels.
(
    id: "ba_scale_harness",
    slot: Chest,
    attach: Some("chest"),
    material: Some("leather"),
    thickness_mul: {
        "spine": 1.12,
        "shoulders": 1.05,
    },
    shapes: [
        Capsule(
            from: (-0.05, -0.02, 0.055),
            to: (-0.16, 0.01, 0.02),
            ramp: Material,
            thick: 1.5,
        ),
        Capsule(
            from: (0.05, -0.02, 0.055),
            to: (0.16, 0.01, 0.02),
            ramp: Material,
            thick: 1.5,
        ),
    ],
)
