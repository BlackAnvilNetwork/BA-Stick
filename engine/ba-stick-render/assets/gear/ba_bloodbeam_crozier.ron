// Bloodbeam crozier. Name-skin of the ashbeam rod: longer shaft plus a hooked
// head. Dust baton through the hand frame, +y along the shaft. Grip wrap at
// the origin. Glow disc sits in the crook, not on a straight tip.
(
    id: "ba_bloodbeam_crozier",
    slot: MainHand,
    attach: Some("r_hand"),
    stance: Some("staff"),
    reach: 0.52,
    swing_weight: 1.1,
    material: Some("dust"),
    shapes: [
        Capsule(from: (0.0, -0.20, 0.0), to: (0.0, 0.48, 0.0), ramp: Material, thick: 1.15),
        Capsule(from: (0.0, -0.08, 0.0), to: (0.0, 0.05, 0.0), ramp: Material, thick: 1.8),
        Capsule(from: (0.0, 0.48, 0.0), to: (0.11, 0.56, 0.0), ramp: Material, thick: 1.2),
        Capsule(from: (0.11, 0.56, 0.0), to: (0.07, 0.64, 0.0), ramp: Material, thick: 1.15),
        Disc(at: None, center: (0.07, 0.64, 0.0), r: 0.028, ramp: Glow),
    ],
)
