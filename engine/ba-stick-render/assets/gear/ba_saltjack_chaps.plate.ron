    id: "ba_saltjack_chaps",
    x0: -0.10,
    y0: 0.02,
    x1: 0.10,
    y1: 0.90,
    z: 0.06,
    flow: 0.0,
    sleeve_drop: 0.0,
    wrap: 0.0,
    arm_from: 0.0,
    arm_to: 0.0,
    arm_thick: 0.0,
    cuff_from: 0.0,
    cuff_to: 0.0,
    cuff_thick: 0.0,
    rows: [
        "llllllll",
        "kllllllk",
        "llddddll",
        "kllllllk",
        "llllllll",
    ],
)
