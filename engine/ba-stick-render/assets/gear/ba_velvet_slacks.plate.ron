//
// One slack face, painted on each thigh. 'c' dark velvet, 'b' mid fold.
// No light 'm'. No 'k' (reads as a hole). Row 0 is the hip edge. The last
// row is the knee hem. Hip-to-knee panels; the inner thigh stays open.
(
    id: "ba_velvet_slacks",
    x0: -0.10,
    y0: 0.02,
    x1: 0.10,
    y1: 1.00,
    z: 0.06,
    flow: 0.0,
    sleeve_drop: 0.0,
    wrap: 0.0,
    arm_from: 0.0,
    arm_to: 0.0,
    arm_thick: 0.0,
    cuff_from: 0.0,
    cuff_to: 0.0,
    cuff_thick: 0.0,
    rows: [
        "cccccccc",
        "cbbbbbbc",
        "ccbbbbcc",
        "cbbbbbbc",
        "cccccccc",
        "cccccccc",
    ],
)
