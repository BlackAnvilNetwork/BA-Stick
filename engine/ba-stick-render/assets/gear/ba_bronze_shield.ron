//
// Bronze shield. Same accepted shield look as the iron shield: the face is
// pixel strips on concentric rings in a plane on the off hand. The rings are
// not drawn. The grip is the capsule behind the face.
(
    id: "ba_bronze_shield",
    slot: OffHand,
    attach: Some("l_hand"),
    stance: Some("shield"),
    material: Some("steel"),
    shapes: [
        Capsule(from: (-0.08, 0.0, 0.16), to: (0.08, 0.0, 0.16), ramp: Material, thick: 2.2),
    ],
)
