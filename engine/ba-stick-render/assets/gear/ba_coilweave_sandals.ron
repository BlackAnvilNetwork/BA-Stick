//
// Leather sandals. One foot in foot-local metres: origin is the foot
// joint, +y up the shin, +z toward the toe, +x the character's right.
// The viewer and draw path instance this pair on l_foot and r_foot so
// the soles walk with the stride. Tiny discs mark each joint.
// Leather: no buckle disc. `thick` is a radius in pixels.
(
    id: "ba_coilweave_sandals",
    slot: Feet,
    attach: Some("pelvis"),
    material: Some("dust"),
    thickness_mul: {
        "l_shin": 1.12,
        "r_shin": 1.12,
    },
    shapes: [
        // Sole width (front).
        Capsule(
            from: (-0.040, -0.018, 0.03),
            to: (0.040, -0.018, 0.03),
            ramp: Material,
            thick: 2.6,
        ),
        // Heel width.
        Capsule(
            from: (-0.035, -0.018, -0.04),
            to: (0.035, -0.018, -0.04),
            ramp: Material,
            thick: 2.4,
        ),
        // Sole length, heel to ball.
        Capsule(
            from: (0.0, -0.018, -0.05),
            to: (0.0, -0.018, 0.03),
            ramp: Material,
            thick: 2.4,
        ),
        // Sole length, ball to toe.
        Capsule(
            from: (0.0, -0.018, 0.01),
            to: (0.0, -0.018, 0.11),
            ramp: Material,
            thick: 2.2,
        ),
        // Instep strap.
        Capsule(
            from: (0.0, -0.018, 0.03),
            to: (0.0, 0.070, 0.03),
            ramp: Material,
            thick: 1.6,
        ),
        // Cross strap (front).
        Capsule(
            from: (-0.035, 0.040, 0.02),
            to: (0.035, 0.040, 0.02),
            ramp: Material,
            thick: 1.5,
        ),
        Disc(at: Some("l_foot"), r: 0.014, ramp: Material),
        Disc(at: Some("r_foot"), r: 0.014, ramp: Material),
    ],
)
