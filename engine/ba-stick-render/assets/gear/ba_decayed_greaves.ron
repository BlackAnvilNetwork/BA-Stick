//
// Decayed greaves. One shin in foot-local metres: origin is the foot
// joint, +y up the shin, +z toward the toe, +x the character's right.
// The viewer and draw path instance this pair on l_foot and r_foot so
// the plates walk with the stride. Tiny discs mark each joint.
// Shorter cracked bone shin plates — not a closed iron boot.
// `thick` is a radius in pixels.
(
    id: "ba_decayed_greaves",
    slot: Feet,
    attach: Some("pelvis"),
    material: Some("bone"),
    thickness_mul: {
        "l_shin": 1.08,
        "r_shin": 1.08,
    },
    shapes: [
        // Front plate, short mid shin.
        Capsule(
            from: (0.0, 0.04, 0.03),
            to: (0.0, 0.14, 0.03),
            ramp: Material,
            thick: 2.2,
        ),
        // Front plate, above-ankle overlap.
        Capsule(
            from: (0.0, 0.04, 0.03),
            to: (0.0, 0.09, 0.03),
            ramp: Material,
            thick: 2.0,
        ),
        // Left wrap, cracked short (gap above the ankle).
        Capsule(
            from: (-0.028, 0.07, 0.012),
            to: (-0.028, 0.13, 0.012),
            ramp: Material,
            thick: 1.8,
        ),
        // Right wrap, full short height.
        Capsule(
            from: (0.028, 0.04, 0.012),
            to: (0.028, 0.14, 0.012),
            ramp: Material,
            thick: 2.0,
        ),
        // Right wrap overlapping the front plate. Left overlap omitted (crack).
        Capsule(
            from: (0.020, 0.05, 0.026),
            to: (0.020, 0.13, 0.026),
            ramp: Material,
            thick: 1.8,
        ),
        Disc(at: Some("l_foot"), r: 0.012, ramp: Material),
        Disc(at: Some("r_foot"), r: 0.012, ramp: Material),
    ],
)
