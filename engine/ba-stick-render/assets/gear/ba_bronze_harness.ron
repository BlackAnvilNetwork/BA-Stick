//
// Bronze strap harness, not a cuirass: steel shoulder straps, three ribs,
// a thin spine strap, and two rear straps. Hide/mesh is the wrap plate in
// ba_bronze_harness.plate.ron. `thick` is a radius in pixels.
(
    id: "ba_bronze_harness",
    slot: Chest,
    attach: Some("chest"),
    material: Some("steel"),
    thickness_mul: {
        "spine": 1.12,
        "shoulders": 1.05,
    },
    shapes: [
        // Shoulder straps, chest out to each shoulder.
        Capsule(
            from: (-0.05, -0.02, 0.055),
            to: (-0.16, 0.01, 0.02),
            ramp: Material,
            thick: 1.4,
        ),
        Capsule(
            from: (0.05, -0.02, 0.055),
            to: (0.16, 0.01, 0.02),
            ramp: Material,
            thick: 1.4,
        ),
        // Three horizontal ribs, chest-wide.
        Capsule(
            from: (-0.12, -0.08, 0.09),
            to: (0.12, -0.08, 0.09),
            ramp: Material,
            thick: 1.5,
        ),
        Capsule(
            from: (-0.11, -0.16, 0.085),
            to: (0.11, -0.16, 0.085),
            ramp: Material,
            thick: 1.4,
        ),
        Capsule(
            from: (-0.10, -0.24, 0.075),
            to: (0.10, -0.24, 0.075),
            ramp: Material,
            thick: 1.35,
        ),
        // Thin spine strap, collar to lower rib.
        Capsule(
            from: (0.0, -0.05, 0.095),
            to: (0.0, -0.26, 0.075),
            ramp: Material,
            thick: 1.3,
        ),
        // Rear straps.
        Capsule(
            from: (-0.11, -0.10, -0.07),
            to: (0.11, -0.10, -0.07),
            ramp: Material,
            thick: 1.35,
        ),
        Capsule(
            from: (-0.10, -0.20, -0.065),
            to: (0.10, -0.20, -0.065),
            ramp: Material,
            thick: 1.3,
        ),
    ],
)
