//
// Shade leather boots. One foot in foot-local metres: origin is the foot
// joint, +y up the shin, +z toward the toe, +x the character's right.
// The viewer and draw path instance this pair on l_foot and r_foot so
// the soles walk with the stride. Tiny discs mark each joint.
// Platform sole plus a closed vamp over the instep — not ankle blobs.
// Leather: no buckle disc. `thick` is a radius in pixels.
(
    id: "ba_last_company_boots",
    slot: Feet,
    attach: Some("pelvis"),
    material: Some("leather"),
    thickness_mul: {
        "l_shin": 1.12,
        "r_shin": 1.12,
    },
    shapes: [
        // Platform sole width (front).
        Capsule(
            from: (-0.042, -0.028, 0.03),
            to: (0.042, -0.028, 0.03),
            ramp: Material,
            thick: 3.2,
        ),
        // Platform heel width.
        Capsule(
            from: (-0.038, -0.028, -0.04),
            to: (0.038, -0.028, -0.04),
            ramp: Material,
            thick: 3.0,
        ),
        // Platform length, heel to ball.
        Capsule(
            from: (0.0, -0.028, -0.05),
            to: (0.0, -0.028, 0.03),
            ramp: Material,
            thick: 3.0,
        ),
        // Platform length, ball to toe.
        Capsule(
            from: (0.0, -0.028, 0.01),
            to: (0.0, -0.028, 0.11),
            ramp: Material,
            thick: 2.8,
        ),
        // Midsole lift, overlapping the platform.
        Capsule(
            from: (0.0, -0.010, -0.04),
            to: (0.0, -0.010, 0.06),
            ramp: Material,
            thick: 2.6,
        ),
        // Vamp slab, sole up over the instep.
        Capsule(
            from: (0.0, -0.018, 0.04),
            to: (0.0, 0.055, 0.04),
            ramp: Material,
            thick: 2.4,
        ),
        // Vamp cover across the instep.
        Capsule(
            from: (-0.036, 0.028, 0.03),
            to: (0.036, 0.028, 0.03),
            ramp: Material,
            thick: 2.2,
        ),
        // Vamp toe wrap, overlapping platform and instep.
        Capsule(
            from: (0.0, -0.010, 0.07),
            to: (0.0, 0.022, 0.10),
            ramp: Material,
            thick: 2.0,
        ),
        Disc(at: Some("l_foot"), r: 0.014, ramp: Material),
        Disc(at: Some("r_foot"), r: 0.014, ramp: Material),
    ],
)
