//
// Altarweave wrist cuffs. Name-skin of velvet cuffs: a short liturgical
// band plus a gold Trim stole wrap. Tiny hand discs are markers. No palm
// bag, no fingers. `thick` is a radius in pixels.
(
    id: "ba_altarweave_cuffs",
    slot: Hands,
    attach: Some("r_hand"),
    material: Some("dust"),
    thickness_mul: {
        "l_forearm": 1.20,
        "r_forearm": 1.20,
    },
    shapes: [
        Capsule(
            from: (0.0, -0.038, 0.0),
            to: (0.0, -0.006, 0.0),
            ramp: Material,
            thick: 1.7,
        ),
        Capsule(
            from: (-0.022, -0.022, 0.008),
            to: (0.022, -0.022, 0.008),
            ramp: Trim,
            thick: 1.4,
        ),
        Disc(at: Some("l_hand"), r: 0.022, ramp: Material),
        Disc(at: Some("r_hand"), r: 0.022, ramp: Material),
    ],
)
