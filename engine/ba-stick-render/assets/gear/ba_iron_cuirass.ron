// Modified: 2026-10-22 — original BA-Stick wearable chest armor asset.
//
// BA Iron Cuirass: one overlapping steel plate, wide at the chest and
// narrower at the waist, plus shoulder caps. The gold rim, ridge, rivets,
// and red medallion are the front-face grid in ba_iron_cuirass.plate.ron.
// `thick` is a radius in pixels, matching Stick Engine capsules.
(
    id: "ba_iron_cuirass",
    slot: Chest,
    attach: Some("chest"),
    material: Some("steel"),
    thickness_mul: {
        "spine": 1.72,
        "shoulders": 1.28,
        "l_upper_arm": 1.12,
        "r_upper_arm": 1.12,
    },
    shapes: [
        // Spine of the plate, collar to below the ribs.
        Capsule(
            from: (0.0, -0.02, 0.05),
            to: (0.0, -0.26, 0.05),
            ramp: Material,
            thick: 3.6,
        ),
        // Chest is wider than the waist. These overlap the spine.
        Capsule(
            from: (-0.055, -0.07, 0.055),
            to: (0.055, -0.07, 0.055),
            ramp: Material,
            thick: 3.5,
        ),
        Capsule(
            from: (-0.035, -0.16, 0.05),
            to: (0.035, -0.16, 0.05),
            ramp: Material,
            thick: 3.1,
        ),
        Capsule(
            from: (-0.015, -0.25, 0.05),
            to: (0.015, -0.25, 0.05),
            ramp: Material,
            thick: 2.6,
        ),
        // A little further down the belly, narrower than the chest.
        Capsule(
            from: (0.0, -0.24, 0.048),
            to: (0.0, -0.38, 0.048),
            ramp: Material,
            thick: 2.2,
        ),

        // Straps from the plate corners out to the shoulder joints.
        Capsule(
            from: (-0.09, -0.05, 0.04),
            to: (-0.18, -0.03, 0.015),
            ramp: Material,
            thick: 2.2,
        ),
        Capsule(
            from: (0.09, -0.05, 0.04),
            to: (0.18, -0.03, 0.015),
            ramp: Material,
            thick: 2.2,
        ),
        Disc(at: Some("l_shoulder"), r: 0.075, ramp: Material),
        Disc(at: Some("r_shoulder"), r: 0.075, ramp: Material),
        Disc(at: Some("l_shoulder"), r: 0.028, ramp: Trim),
        Disc(at: Some("r_shoulder"), r: 0.028, ramp: Trim),
    ],
)
