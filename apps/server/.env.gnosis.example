# Gnosis mainnet (100) — copy keys into apps/server/.env.local (gitignored).
# Addresses fill from deployments/gnosis.json when left blank (never MockItems).

LOK_CHAIN_ID=100
# LOK_CHAIN_RPC=https://rpc.gnosischain.com
# LOK_PUBLIC_RPC=https://rpc.gnosischain.com
# LOK_DEPLOY_JSON=../../deployments/gnosis.json

# Optional overrides (otherwise loaded from deploy JSON):
# LOK_NFT=
# LOK_FACTORY=
# LOK_AH_ESCROW=
# LOK_CHECKPOINT=
# LOK_RULESETS=
# LOK_ITEMS=   # real Items.sol only — leave unset until official Items deploy

# LISTING_ROLE server key (distinct from Safe / fee recipient)
LOK_LISTING_KEY=

# Blocks behind tip for AhEscrow + NFT transfer watchers (Gnosis ~5s/block; default 2)
# LOK_CONFIRMATIONS=2

# Never on mainnet:
# LOK_DEV_FAUCET=
# LOK_DEV_SERVER_MINT=
