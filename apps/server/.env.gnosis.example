# Gnosis mainnet (100) — copy into apps/server/.env.local (gitignored).
# No secrets in git. Addresses fill from deployments/gnosis.json when blank.
# Never wire dry-run MockItems (status: dry-run-only in that JSON).

NETWORK=gnosis
# LOK_NETWORK=gnosis   # alias

# Profile defaults (override only if needed):
# LOK_CHAIN_ID=100
# LOK_CHAIN_RPC=https://rpc.gnosischain.com
# LOK_CHAIN_RPC_URLS=https://rpc.gnosischain.com,https://gnosis-rpc.publicnode.com,https://rpc.ankr.com/gnosis
# LOK_PUBLIC_RPC=https://rpc.gnosischain.com
# LOK_CONFIRMATIONS=2
# LOK_EXPLORER=https://gnosisscan.io
# LOK_BLOCKSCOUT=https://gnosis.blockscout.com
# LOK_DEPLOY_JSON=../../deployments/gnosis.json
# LOK_DEPLOY_BLOCK=   # set after official deploy (watcher backfill start)

# Optional address overrides (otherwise loaded from deploy JSON — never MockItems):
# LOK_NFT=
# LOK_FACTORY=
# LOK_AH_ESCROW=
# LOK_CHECKPOINT=
# LOK_RULESETS=
# LOK_ITEMS=   # real Items.sol only — leave unset until official Items deploy

# LISTING_ROLE server key (distinct from Safe / fee recipient / rotator / proposer)
LOK_LISTING_KEY=

# Never on mainnet:
# LOK_DEV_FAUCET=
# LOK_DEV_SERVER_MINT=
