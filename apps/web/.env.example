# Copy to .env.local (gitignored). Enables WalletConnect on the boot screen.
VITE_WALLETCONNECT_PROJECT_ID=

# --- Robinhood mainnet (production target) ---
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
VITE_CHAIN_ID=4663

# --- Local preview / anvil (character mint + faucet; server uses chain 31337) ---
# Pay/mint switch the wallet to 31337 automatically; for WC login on preview also set:
# VITE_CHAIN_ID=31337
# VITE_RPC_URL=http://127.0.0.1:8545
# VITE_ANVIL_RPC_URL=http://127.0.0.1:8545
# Mobile WC cannot use 127.0.0.1 — point at a reachable host (same LAN or tunnel):
# VITE_ANVIL_PUBLIC_RPC_URL=http://192.168.1.10:8545

# Optional: override WebSocket to the game server
# VITE_WS_URL=ws://localhost:8787
