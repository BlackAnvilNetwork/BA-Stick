# Copy to .env.local (gitignored). Enables Reown AppKit Connect (wallet picker).
# Public Reown project id (safe to commit). Override locally if you use another project.
# Required for production builds when VITE_NETWORK is gnosis/chiado (or chain 100/10200).
VITE_WALLETCONNECT_PROJECT_ID=2b84a147e46a4cd3903bc8f5c71c1e55

# Without a project ID in local DEV, Connect still works via injected MetaMask/Rabby.
# Production gnosis/chiado builds fail without a project id (no silent burner fallback).

# Settlement profile — gnosis (100) | chiado (10200) | anvil (31337)
# Burner game-auth / pay identity is allowed only when this is anvil.
VITE_NETWORK=gnosis

# Explicit overrides (win over VITE_NETWORK):
# VITE_CHAIN_ID=100
# VITE_RPC_URL=https://rpc.gnosischain.com
# VITE_GNOSIS_RPC_URL=https://rpc.gnosischain.com
# VITE_CHIADO_RPC_URL=https://rpc.chiado.gnosis.gateway.fm
# VITE_ETH_RPC_URL=https://ethereum.publicnode.com

# Settlement contract addresses are server-side (LOK_NFT / LOK_FACTORY / LOK_AH_ESCROW)
# from deployments/gnosis.json — not Vite env.

# --- Local preview / anvil ---
# VITE_NETWORK=anvil
# VITE_CHAIN_ID=31337
# VITE_RPC_URL=http://127.0.0.1:8545
# VITE_ANVIL_RPC_URL=http://127.0.0.1:8545
# VITE_ANVIL_PUBLIC_RPC_URL=http://192.168.1.10:8545
# VITE_ALLOW_ANVIL_WC=1

# Optional: override WebSocket to the game server
# VITE_WS_URL=ws://localhost:8787
