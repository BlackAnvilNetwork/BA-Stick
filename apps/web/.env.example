# Copy to .env.local (gitignored). Enables WalletConnect on the boot screen.
VITE_WALLETCONNECT_PROJECT_ID=
# Public RPC for WalletConnect / pay (Robinhood mainnet default in code if unset)
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Target chain id (4663 = Robinhood Chain)
VITE_CHAIN_ID=4663
# Optional: override WebSocket to the game server
# VITE_WS_URL=ws://localhost:8787
