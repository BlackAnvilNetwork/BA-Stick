# Official Gnosis (100) / Chiado (10200) — copy to .env.gnosis (gitignored). Never commit real keys.
PRIVATE_KEY=
RPC_URL=https://rpc.gnosischain.com

# Safe multisig — admin (+ default emergency/guardian)
ADMIN=
# EMERGENCY=   # optional, defaults to ADMIN
# GUARDIAN=    # optional, defaults to ADMIN

# Distinct treasury (not Safe, not server keys)
FEE_RECIPIENT=

# Distinct server EOAs
LISTING=
ROTATOR=
PROPOSER=

# Real access-controlled ERC-1155, or 0x000…000 to leave imports/exports off.
# Never MockItems on 100/10200.
ITEMS=0x0000000000000000000000000000000000000000
KEK=0x0000000000000000000000000000000000000000

BASE_URI=https://legendofkek.com/character/
# 1 xDAI — DeployChiado default when unset
MINT_FEE=1000000000000000000
