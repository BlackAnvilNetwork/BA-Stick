# Chiado (10200) — copy to .env.chiado (gitignored). Prefer docs/gnosis-launch.md for official role layout.
PRIVATE_KEY=
CHIADO_RPC_URL=https://rpc.chiado.gnosis.gateway.fm
RPC_URL=${CHIADO_RPC_URL}

ADMIN=
# EMERGENCY=   # optional, defaults to ADMIN
# GUARDIAN=    # optional, defaults to ADMIN
FEE_RECIPIENT=
LISTING=
ROTATOR=
PROPOSER=

# Real items or zero (imports/exports off). Never MockItems on Chiado.
ITEMS=0x0000000000000000000000000000000000000000
KEK=0x0000000000000000000000000000000000000000

BASE_URI=https://legendofkek.com/character/
MINT_FEE=1000000000000000000
