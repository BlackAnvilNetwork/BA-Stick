# Chiado (Gnosis testnet) — copy to .env.chiado (gitignored). Do NOT commit real keys.
# Do NOT broadcast until explicit go-ahead. See docs/chiado-deploy.md.

PRIVATE_KEY=
CHIADO_RPC_URL=https://rpc.chiado.gnosis.gateway.fm

# DeployChiado / Deploy.s.sol
MULTISIG=
ROTATOR=
GUARDIAN=
PROPOSER=
# LISTING=   # optional; defaults to ROTATOR
ITEMS=
KEK=
BASE_URI=https://example.invalid/character/

# Native xDAI mint fee in wei. Default = 1 xDAI (10^18). Flagged for product in docs/mainnet-plan.md.
MINT_FEE=1000000000000000000

# After deploy, server env (not used by forge):
# LOK_CHAIN_ID=10200
# LOK_CHAIN_RPC=$CHIADO_RPC_URL
# LOK_PUBLIC_RPC=$CHIADO_RPC_URL
# LOK_AH_ESCROW=
# LOK_CHARACTER_NFT=
# LOK_CHARACTER_FACTORY=
# LOK_LISTING_KEY=
