{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@bellgrave/combat": [
        "../combat/src/index.ts"
      ],
      "@bellgrave/config": [
        "../config/src/index.ts"
      ],
      "@bellgrave/protocol": [
        "../protocol/src/index.ts"
      ],
      "@bellgrave/client-core/*": [
        "../client-core/src/*"
      ],
      "@bellgrave/items": [
        "../items/src/index.ts"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}